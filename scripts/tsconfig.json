{
  "include": [
    "./src/backend",
    "./scripts"
  ],
  "exclude": [
    "./src/frontend",
    "./dist"
  ],
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "module": "node16",
    "target": "ES2022",
    "esModuleInterop": true,
    "moduleResolution": "node16",
    "allowSyntheticDefaultImports": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
  }
}